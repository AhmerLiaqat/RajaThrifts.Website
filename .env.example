# Copy to .env.local and fill in. Restart `npm run dev` after changes.
#
# ⚠️  Everything prefixed VITE_ is bundled into PUBLIC JavaScript.
#     Only ever use the anon / publishable key here.
#     NEVER put the service_role or sb_secret_ key in this file (the app refuses to start if you do).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# App
VITE_APP_NAME=RajaThrifs
# Used for auth email links (confirmation, password reset). Must be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_APP_URL=http://localhost:5173
VITE_CURRENCY=PKR
VITE_LOCALE=en-PK

# Supabase Storage bucket for product images (created by the migrations)
VITE_PRODUCT_IMAGES_BUCKET=product-images

# Serve the built-in demo catalog even when Supabase is configured.
# Always on when Supabase is not configured. Checkout is disabled in demo mode.
VITE_USE_DEMO_CATALOG=false

# Development only: open /admin without logging in (UI only; the database still enforces RLS).
# Ignored in production builds.
VITE_DEV_ADMIN_BYPASS=false
